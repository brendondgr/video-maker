# --- Dependencies ---
node_modules/
.npm/
.pnpm-store/
.yarn/

# --- Generated by the engine (re-created by qa/render scripts) ---
# rendered videos (render.mjs, layout 1)
**/out/
# QA reports, lint/check JSON, snapshot frames (layout 1)
**/qa/
# packaged skill archives
*.tgz

# --- Scratch / local-only ---
_to_delete/
tmp/
*.tmp
*.bak

# --- Secrets / local config ---
.env
.env.*
!.env.example
.claude/settings.local.json

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python (in case helper scripts get added) ---
__pycache__/
*.py[cod]
.venv/

# --- Test / coverage output ---
coverage/
.nyc_output/
test-results/
playwright-report/

# --- OS junk ---
.DS_Store
._*
Thumbs.db
desktop.ini
.directory

# --- Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- video-maker: per-project link to the engine (created by the scripts) ---
**/_engine

# --- voice-over audio (re-created by voiceover.mjs; timing/captions JSON stay tracked) ---
**/audio/**/*.wav

# --- Project layout 2 (generated; see engine/scripts/lib/paths.mjs) ---
# disposable caches, QA output and previews
**/.build/
# the edit package (per-scene clips, stems, timeline) and finished exports
**/edit/
**/exports/
